# Server-side only — NEVER prefix these with VITE_. A VITE_-prefixed var is
# inlined into the client bundle by Vite at build time, which is exactly the
# bug this proxy setup fixes. These are read only by the serverless functions
# in /api (and, in dev, by the Vite dev-proxy plugin in vite.config.ts).
#
# Set the real values here for local `npm run dev`, AND separately in the
# Vercel project's dashboard (Settings → Environment Variables) for
# production/preview deploys — they are not read from this repo in prod.
NEWSAPI_KEY=your_newsapi_key_here
# Optional — tried in order only when NEWSAPI_KEY hits a rate limit (429) or
# is rejected (401). Used by both the top-headlines and everything endpoints.
NEWSAPI_KEY_BACKUP_1=
NEWSAPI_KEY_BACKUP_2=
CURRENTS_KEY=your_currents_key_here
# Optional — tried in order only when CURRENTS_KEY hits a rate limit (429) or
# is rejected (401).
CURRENTS_KEY_BACKUP_1=
CURRENTS_KEY_BACKUP_2=
GROQ_KEY=your_groq_key_here
# Optional — tried in order only when GROQ_KEY hits a rate limit (429) or is
# rejected (401). Leave unset if you don't have backup keys; the app works
# fine with just GROQ_KEY.
GROQ_KEY_BACKUP_1=
GROQ_KEY_BACKUP_2=

# Optional — a free personal key from open-platform.theguardian.com/access.
# Falls back to Guardian's public 'test' demo key if unset (shared quota
# across all developers using it, so a real key is worth getting).
GUARDIAN_KEY=
# Optional — tried in order only when GUARDIAN_KEY hits a rate limit (429) or
# is rejected (401).
GUARDIAN_KEY_BACKUP_1=
GUARDIAN_KEY_BACKUP_2=

# Optional — free key from rss2json.com. Without any key, Google News RSS
# conversion still works but at rss2json's much lower anonymous rate limit
# (this is what was hitting 429s before). Tried in order, same fallback
# pattern as the other sources.
RSS2JSON_KEY=
RSS2JSON_KEY_BACKUP_1=
RSS2JSON_KEY_BACKUP_2=
RSS2JSON_KEY_BACKUP_3=
RSS2JSON_KEY_BACKUP_4=

# Client-side (safe to expose) — get your FREE Pexels key at
# https://www.pexels.com/api/ (takes 2 minutes). When set, articles get real
# editorial photos instead of stock images.
VITE_PEXELS_KEY=

# Client-side — gates the /ops/review UNLOCK SCREEN only (a convenience,
# same passphrase you set below). This is NOT real authentication — it ships
# inside the bundle like any VITE_ var. Leave unset to disable the route
# entirely (it refuses to unlock with no passphrase configured).
VITE_REVIEW_PASSPHRASE=

# Server-side only — the REAL security boundary. Every approve/reject/edit
# write to the shared ledger goes through api/ledger.ts, which checks the
# passphrase the client sent against THIS var (never shipped to the
# browser). Use the same value as VITE_REVIEW_PASSPHRASE above for a single
# passphrase to remember.
REVIEW_PASSPHRASE=

# Server-side only — the shared L/W Ledger + Vaada Clock store, so every
# visitor sees the same growing data instead of each browser having its own
# separate IndexedDB copy. Free forever at upstash.com (no card required):
# create a Redis database, copy its REST URL + token here. Leave both unset
# to keep everything IndexedDB-only (per-browser) as before — the app
# degrades gracefully, nothing breaks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-side only — verifies that /api/cron/ledger-extract (the daily
# automated promise/verdict extraction job, see vercel.json's `crons`) was
# actually invoked by Vercel's own scheduler and not a public hit on the same
# URL. Vercel auto-sends this exact env var's value as the request's
# Authorization header when it fires the cron — just set any random string
# here and add the same value in the Vercel dashboard.
CRON_SECRET=
